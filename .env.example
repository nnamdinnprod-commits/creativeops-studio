# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The application must run fully without any key set (AI_PROVIDER=mock).

# mock | openai | anthropic
AI_PROVIDER=mock

# Only needed if AI_PROVIDER is not "mock"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model name for the selected provider
AI_MODEL=

DATABASE_URL=sqlite:///./creativeops.db

# Utilisation percentage above which a person is flagged "Tight"
CAPACITY_TIGHT_THRESHOLD=85

# Minimum brief readiness score required to leave the "ready" column
BRIEF_READINESS_THRESHOLD=70

APP_ENV=development
LOG_LEVEL=INFO
